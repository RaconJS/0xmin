//possible bug: breaking at "I" with score 0x1000???
//BUG: double merging when "A" pressed with "AABC" pattern
#"ZASM3";#"tptasm";#"len";
//#"target_assembly";
:global;
#import lib "R2/print.0xmin";
#import lib "R2/getInput.0xmin";
let RegEnum(start:#)={
	#return <-> start||0;
	()={
		#..this <-> ..constructor;
		repeat(+..constructor>=14)throw "out of registers";
		#..constructor<->..constructor+1;
		%..this;
	};
	let ..prototype = {
		let move(newReg:%)<-{//note: I do not remember why this a macro
			#newReg<->this; 
		}::{
			let ..prototype = {
				let = this;
			};
		};
		let share(reg:%){//this:!owned ; using type annotation comments (as of 14/11/25 there is no # type checking)
			#reg<->this;
		};
	};
};
let alloc{
	let stack(obj:{@}){
		defer global: def obj;
		#return = obj;
	};
};
let grid = {//:char[]
	"    ";
	"    ";
	"    ";
	"    ";
	let size{4;4};
	let nullChar = +" ";
	:self;
	defer global def self;
};
let random{
	defer global def ..this;
	let numbers{
		defer global def ..this;
		repeat 200 @(0x10000*0xmin.Math.random()|0);
	};
	let currentNumber = {@numbers};//:@{@*}
	defer global def currentNumber;
	let output = {0};
	defer global def output;
	push r0;
	r0 = [currentNumber];
	r0 = [r0];
	//{:TEST;print(" ");print.register(0);};
	[output] = r0;
	[currentNumber] += 1;
	let reset{
		push r0;
		r0 = numbers;
		[currentNumber] = r0;
		pop r0;
		return;
	};defer ..this def reset;
	{:block;
		r0 = numbers..return;
		[currentNumber] - r0;
		jump -> block..return if <= 0 !signed;
		call reset;
	};
	pop r0;
	return;
};
let regEnum = RegEnum();
let const_0 = regEnum();
let score = regEnum();
%const_0 = 0;
call random.reset;
let arrowKeysDisplay {
	let inactiveColor = +"\c9f";
	let activeColor = +"\c17";
	let print_mod = print;
	let Key(key:char,pos:char){
		...labelsof arguments;
		let print(){
			print_mod(""...pos...key,const_0,{});
		}::{
			let active(){
				send %const_0 activeColor;
				$..this();
			};
			let inactive(){
				send %const_0 inactiveColor;
				$..this();
			};
		};
	};
	defer ..this:delete Key;
	let W <=> Key("w","\p38");
	let A <=> Key("a","\p47");
	let S <=> Key("s","\p48");
	let D <=> Key("d","\p49");
};
let printGrid{
	let regEnum=RegEnum(regEnum);
	let posChar = +"\p21";//sets offet for the board position
	let drawBoarder{//draws cosmetic displays
		//     0123456789ABCDEF
		print(" \c0a2048\c07"...
		           "    WASD to\c07",const_0,{});
		print(" ----    move.\n",const_0,{});
		print("|\p25|\n",const_0,{});
		print("|\p35|\n",const_0,{});
		print("|\p45|\n",const_0,{});
		print("|\p55|\n",const_0,{});
		print(" ----\n",const_0,{});
		let score.drawColor = +"\c0b";
		print("\c0fscore: "...score.drawColor..."0x0000\c0f\n",const_0,{});
		let score.posChar = +"\p79";
		let score.print{
			send %const_0 score.posChar;
			send %const_0 score.drawColor;
			print.number(score);
		};
	};
	//let currentTilePtr = regEnum();
	//%i = grid.size.(1);
	//%currentTilePtr = grid;
	let printGrid_meta(printPartGetter){
		#let grid_n<->0;
		$grid_n=>grid;
		//send %const_0 "\p00";
		send %const_0 printGrid.posChar;
		let i = -1;
		repeat +grid.size[1]{
			repeat +grid.size[0]{
				printPartGetter(grid_n);
				$grid_n=>grid_n+1;
			};
			#i+=1;
			repeat(i < (grid.size[1]-1)):{
				send %const_0 #(printGrid.posChar + ((i+1)<<4));
			};
		};
	};
	print("\c0f",const_0,{});
	printGrid_meta((grid_n){
		send %const_0 [grid_n]
	});
	def score.print;
	print("\c0f\n",const_0,{});//move to the bottom of display ready for extra printing
	return;
	let blank{
		printGrid_meta((grid_n){send %const_0 " "});
	};
};defer: def printGrid;
sp = 0;
def let resetGame {
	%score = 0;
	def printGrid.drawBoarder;
	print(""...arrowKeysDisplay.inactiveColor,const_0,{});
	arrowKeysDisplay.W.print();
	arrowKeysDisplay.A.print();
	arrowKeysDisplay.S.print();
	arrowKeysDisplay.D.print();
};
${:main;
	{:pick_randomTile;
		let regEnum = RegEnum(regEnum);
		let tileNumber = regEnum();
		//%tileNumber = #(grid.size[0]*grid.size[1]-1);
		let randomNumber = regEnum();
		let i = regEnum();
		let temp = regEnum();
		let randomNumber_store{0#def let randomNumber;1#def let i};
		defer global def randomNumber_store;
		%randomNumber = [randomNumber_store.randomNumber];
		%i = [randomNumber_store.i];
		${:loop;
			{:block;
				%randomNumber >>= 4;
				%i -= 1;
				jump->block..return if !=0;
				%i = 4;
				call random;
				%randomNumber = [random.output];
			};
			%tileNumber = %randomNumber;
			%tileNumber &= 0xf;//(grid.size[0]*grid.size[1]-1)
			%tileNumber+=grid;
			%temp = [%tileNumber];
			%tileNumber-=grid;
			%temp - grid.nullChar;
			jump -> loop if != 0;
		};
		[randomNumber_store.randomNumber] = %randomNumber;
		[randomNumber_store.i] = %i;
		%tileNumber += grid;
		:block;
		{
			let =i,=randomNumber,=temp;//:%int,%bool
			let bit <-> temp;
			#block::{delete i,randomNumber};
			let randomBits_store{0;1#def let i};
			defer global def randomBits_store;
			%randomNumber = [randomBits_store];
			%i = [randomBits_store.i];
			{:checkNeedNextRandom;
				:block;
				%i -= 1;
				jump -> block..return if > 0;
				%i = 16;
				call random;
				%randomNumber = [random.output];
			};
			{:block;
				%bit = %randomNumber;
				%bit &= 1;
				let newTile <-> bit;
				%newTile += "A";
				[%tileNumber] = %newTile;
			};
			%randomNumber >>= 1;
			[randomBits_store] = %randomNumber;
		};
		%tileNumber -= grid;
	};
	call printGrid;
	{:checkEndGame;
		let regEnum = RegEnum(regEnum);
		let temp_nullChar = regEnum();
		%temp_nullChar = grid.nullChar;
		let i = -1;
		let pos;
		$pos=>grid;
		repeat(grid.size[0]*grid.size[1]):{
			%temp_nullChar - [pos];
			jump -> checkEndGame..return if == 0;
			$pos=>pos + 1;
		};
		let cellValue = regEnum();
		let neighbourCellValue = regEnum();
		let i = 0;
		$pos=>grid;
		repeat(grid.size[0]*grid.size[1]):{//checks neighbours
			$pos => grid + i;
			defer: #i = i + 1;
			let x = i%grid.size[0];//:#int
			let y = i/grid.size[0] |0;//:#int
			repeat(i < (grid.size[0]*grid.size[1] - 1)): {//don't need to check the last one
				%cellValue = [pos];
				let checkNeighbour(pos,offset){//checks if neighbour is the same i.e. can be merged
					let pos1;
					$pos1 => pos + offset;
					%cellValue - [pos1];
					jump -> checkEndGame..return if == 0;
				};
				repeat(x < (grid.size[0]-1)):checkNeighbour(pos,1);
				repeat(y < (grid.size[1]-1)):checkNeighbour(pos,grid.size[0]);
			};
		};
		{:endGame;
			print("\p60\c0cgame over",const_0,{});
			print("\c0f",const_0,{});
			hlt;
			print("\p60\c0f         ",const_0,{});
			def printGrid.blank;
			jump -> resetGame;
		};
	};
	${:handleInput;
		let regEnum = RegEnum(regEnum);
		let inputChar = regEnum();
		let isEqual(a,b,do){
			@:subs $(a) $(b);//BUG: @$a-$b; throws an error
			jump->return..return if != 0;
			def do;
		};
		let moveTiles{
			let regEnum = RegEnum(regEnum);
			defer global:def ..this;
			let temp <-> inputChar;let inputChar = ¬;
			let changeMade = regEnum();//:%(u16 & bool) ; is true if any tiles moved after calling this function
			let stepSize = regEnum();//:%const int
			let startingTile = regEnum();
			let reshift = regEnum();
			let output{
				let =changeMade;
			};
			let inputs{
				let =stepSize,=startingTile,=reshift;
			};
			let currentTile <-> startingTile;
			let currentFreeTile = regEnum();//:([]grid)*
			%currentTile += grid;//:%([]grid)* & %&mut(mut*)
			%changeMade = 0;
			let i=regEnum(),j=regEnum();
			let entry;
			%i = grid.size.(1);
			${:loop;//doFor
				%j = #(grid.size.(0)-1);//note: using 'len-1' since the end value cannot be moved
				#{repeat (+grid.size.(0)!=+grid.size.(1))throw "assertion failed";};
				%currentFreeTile = %currentTile;
				%currentTile += %stepSize;
				//%currentTile += %stepSize;
				${:loop;//doFor
					//let nextTile = regEnum();//:%[]grid ; UNUSED
					let getNextTile = {@[%currentTile+%stepSize]};
					let thenPlace, thenStack, thenShift_increase;
					{:cases;
						let currentTileValue <-> temp;
						let finally;
						%currentTileValue = [%currentTile];
						%currentTileValue - grid.nullChar;
						jump->cases..return if == 0;//assert: `[%currentTile]` != nullChar
						[%currentFreeTile] - grid.nullChar;
						jump->finally if == 0;
						[%currentFreeTile] - %currentTileValue;
						jump->thenShift_increase if == 0;
						def thenStack{//'A B' -> 'AB '
							%currentFreeTile += %stepSize;
							jump->finally;
						};
						def thenShift_increase{//'A A' -> 'B  '
							%currentTileValue += 1;//:char
							{:updateScore;
								let regEnum = RegEnum(regEnum);
								let tileValueAsInt = regEnum();
								%tileValueAsInt = %currentTileValue;
								%tileValueAsInt -= "A";//:int
								let tileScore = regEnum();
								%tileScore = 2;
								%tileScore <<= %tileValueAsInt;
								%score += %tileScore;
							};
							${:checkWin;
								%currentTileValue - (10+"A");
								jump -> checkWin..return if <= 0;
								print("\c0ayou win!");
								hault;
								jump -> resetGame;
							};
						};
						def finally{
							#def thenPlace;
							%currentTile - %currentFreeTile;
							jump -> ..return if == 0;
							%changeMade = 1;
							[%currentFreeTile] = %currentTileValue;
							[%currentTile] = grid.nullChar;
						};
					};
					%currentTile += %stepSize;
					%j -= 1;
					jump->loop if > 0;
				};
				%currentTile += %reshift;
				%i -= 1;
				jump->loop if > 0;
			};
			return;
		};
		awaitInput(inputChar);
		${:moveTiles_block;
			isEqual(inputChar,+"w")<:{
				...moveTiles.inputs;
				%startingTile = 0;//:%grid+
				%stepSize = grid.size.(0);
				%reshift = #(1 -(grid.size.(0)*grid.size.(1)) & 0xffff);
				arrowKeysDisplay.W.print.active();
				call moveTiles;
				arrowKeysDisplay.W.print.inactive();
				jump->moveTiles_block..return;
			};
			isEqual(inputChar,+"a")<:{
				...moveTiles.inputs;
				%startingTile = 0;//:%grid+
				%stepSize = 1;//grid.size.(0);
				%reshift = 0;//#(grid.size.(0)*(grid.size.(1)-1)+1);
				arrowKeysDisplay.A.print.active();
				call moveTiles;
				arrowKeysDisplay.A.print.inactive();
				jump->moveTiles_block..return;
			};
			isEqual(inputChar,+"s")<:{
				...moveTiles.inputs;
				%startingTile = #(grid.size.(0)*(grid.size.(1)-1));//:%grid+
				%stepSize = #(-grid.size.(0) & 0xffff);
				%reshift = #(1 + (grid.size.(0)*grid.size.(1)));
				arrowKeysDisplay.S.print.active();
				call moveTiles;
				arrowKeysDisplay.S.print.inactive();
				jump->moveTiles_block..return;
			};
			isEqual(inputChar,+"d")<:{
				...moveTiles.inputs;
				%startingTile = #(grid.size.(0)-1);//:%grid+
				%stepSize = #(-1 & 0xffff);//grid.size.(0);
				%reshift = #(grid.size.(0)*2);//#(grid.size.(0)*(grid.size.(1)-1)+1);
				arrowKeysDisplay.D.print.active();
				call moveTiles;
				arrowKeysDisplay.D.print.inactive();
				jump->moveTiles_block..return;
			};
			isEqual(inputChar,+"S")<:{
				repeat 0 {
					let string{import "2048.0xmin" as text};
					let i = -1;
					let size = 3;
					repeat(string..length/size):@(string[(i+=1)*size]|(string[i*size+1]<<8)|(string[i*size+2]<<16));
				};
				jump->moveTiles_block;
			};
			jump->handleInput;
		};
		%moveTiles.changeMade|0;
		jump->handleInput if == 0;
	};
	jump->main;
};
debugger {let [2.3] = 2}[2.4];