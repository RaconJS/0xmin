#"ZASM3";
#"target_assembly";
#"len";
#"table";
#"tptasm/R316";
...labelsof{
	let Enum(v)={
		#return <-> v||8;
		(){
			repeat(v > 31) throw "out of registers ; got 'r"...+v..."'";
			repeat(v < 1) throw "invalid register 'r"...+v..."'";
			#return <-> ..this;
			#..this <-> ..this + 1;
			#length += 1;
		};
		let start <-> return;
		let length = 0;
	};
	let static{let data};
	let static.stack;//:{@}&u32[] ; fixed size stores registers
		//the size of the stack should be tracked at compile time
	let dynamic{
		def let heap;
		let stack <-> 0x8000;//starts at 0x7fff
	};
	let var(obj,owner)={
		#owner ||= static.data;
		#owner = owner[¬constructor] || owner;
		#return = obj;
		#owner..splice(-0,0,{def obj});
	};
};
...labelsof{
	let sendToTerminal(reg){
		st %reg r0 0x9000;
	};
	let call(obj){//'$call(obj)'
		#return..constructor.add(obj);
		jump %obj.ret obj;
	}::{
		let add(obj){//obj:{@;#ret:%,enum:Enum} ; adds the 'call' trait to 'obj'
			repeat (obj.enum..constructor != Enum) throw "obj.enum:Enum required";
			repeat !obj.ret let obj.ret <-> obj.enum();
		};
	};
	let sync(){
		jump->return if !sync;
	};
	let setU32(register,MSBvalue,LSBvalue){
		exh %register $(MSBvalue);
		%register = %register $(LSBvalue);
	};
	let setU32_const(register,MSBvalue,LSBvalue){
		exh %register MSBvalue;
		%register = %register LSBvalue;
	};
	let print{//for the R2-terminal
		(value){
			$(
				value..@..length>1 && inline(value)
				|| u16.call_safe(value)
			);
		};
		let string{
			{
				let char <-> 1;
				let char.stored{0};
				st %char char.stored;
				defer: ld %char char.stored;
				defer ..this: def char.stored;
				%char
			};
			jump -> %ret;
		};
		let inline(string,temp_char_reg,isChar){
			let char = temp_char_reg;
			let hasReg = !!char;
			repeat !+hasReg {
				#char = 1;
				let storedChar{0};
				st %char storedChar;
				static.data..splice(-0,0,{def storedChar});
				defer return: ld %char storedChar;
			};
			repeat !isChar exh %char 0x2002;
			string..iterate((v){
				%char = %char v;
				let awaitNextFrame;
				jump -> awaitNextFrame !sync #def awaitNextFrame;
				st %char r0 0x9000;
			});
		};
		let unsignedPrintFunctionFactory(numOfDigits)<-{
			let enum = Enum(1);
			let ret <-> enum();
			let input{
				ins let number <-> enum();//:%mut & %u32
			};
			let size <-> enum();//:%(1..=4)
			let handleNumberTypes(number){//:#(%u16|#u16|@u16)->{@}
				...((number * 0 == 0 && !number..length) && {
					%input.number = %number;//number:%usize
				}) || ((number * 0 == 0) && {
					%input.number = number;//number:#usize
				}) || {
					ld %input.number number;//number:@usize
				};
			};
			let call(number,regState){//:#(%u32|#u32|@u32,#%[]?)->{@}
				//TODO: check for enum collitions
				handleNumberTypes(number);
				jump %ret #(..this);
			};
			let data;
			let storage;
			let call_safe(number){//:#(%u32|#u32|@u32,#%[]?)->{@}
				repeat !storage..length #{
					#storage::{repeat enum.length 0};//null value
				};
				storage..iterate()<:(v,i)=>{
					let value;
					$set value => storage + i;
					let register = enum.start + i;
					st %register value;
					defer return: ld %register value;
				};
				handleNumberTypes(number);
				jump %ret #(..this);
			};
			let ..function = call_safe..function;
			let currentNumber = input.number;
			let chars = #(¬"0123456789ABCDEF")..iterate((v){@(v|0x20020000)});
			let i <-> size;
			let temp <-> enum();
			%i = numOfDigits;
			{
				${:loop;
					let char <-> temp;
					%temp = %currentNumber;
					%temp >>= 12;
					%temp &= 0xf;
					ld %temp %temp chars;//:%(u32 & []chars & %char)
					sync();
					st %temp r0 0x9000;//sends to terminal
					%currentNumber <<= 4;
					%i -= 1;
					jump -> loop if > 0;
				};
			};
			jump -> %ret;
			def data{
				def chars;
				def storage;
			};
		};
		defer: delete unsignedPrintFunctionFactory;
		let u16{
			unsignedPrintFunctionFactory(4);
		};
		let u4(value,enum){//:#(%u4|@u4|$(%?,@?))->{@}
			let storage;
			let temp <-> 1;//:%u4
			st %temp storage;
				def: value * 0 == 0
					&& {%temp = %value}
					|| {ld %temp value};
				%temp &= 0xf;
				ld %temp %temp u16.chars;//:%(u32 & []chars & %char)
				sync();
				st %temp r0 0x9000;//sends to terminal
			ld %temp storage;
			jump -> return..return;
			0 #def storage;
			repeat !u16.chars..defs def u16.chars;
		};
	};
	let for(iOrEnum,start,condision,next,loopEntryIndex,do){
		let enum = iOrEnum..constructor == Enum && Enum(iOrEnum) || ¬;
		let i = enum && enum() || iOrEnum;
		start(i,enum);
		let loopEntry;
		let loopEntry.code{
			jump -> loopEntry;
		};
		repeat(loopEntryIndex > 0) def loopEntry.code;
		def let loop{
			do(i,enum);
			$next() || {%i -= 1};
			jump -> loop if > 0;
			#..splice(loopEntryIndex - 1,0,{loopEntry});
		};
	}::{
		let: repeat(enum,size,do,step){
			#step ||= 1;
			let i = enum..constructor == Enum && enum() || enum;
			repeat enum..constructor == Enum #enum = Enum(enum);
			%i = #(size - 1);
			let loopEntry;
			def let loop{
				do(i,enum);
				%i -= $(step);
				jump -> loop if >= 0;
			};
		};
	};
	let printArray(enum,array,numberSize){
		#enum ||= Enum();
		print.inline("[");
		for.repeat(enum,array..@..length)<:(i,enum){
			let temp <-> enum();
			ld %temp %i array;
			$(+numberSize==4&&print.u4(temp)||print.u16.call_safe(temp));
			r0 = %i | 0;
			jump -> return..return if == 0;
			print.inline(",");
		};
		print.inline("]");
	}::{let short(){#return = ..this(...arguments,4)}};
};
let bubbleSort{//:@(list:%&{MSB u16[s]*;LSB s:u16})->mutate list[0]
	let enum = Enum();
	let ret <-> enum();
	let input{
		ins let list{
			ins let ptr{let const} <-> enum();
			ins let size{let const} <-> enum();
		} <-> list[0];//:%{u16&(mut u32[])*;size:u16}
	},output{
		ins let list = list;//:%{u32[]*;size:u16}
	};
	{:functionBody;
		let size,ptr;{
			#size <-> enum();
			%size = %input.list;
			exh %input.list %input.list;
			defer functionBody: exh %input.list %input.list;
			#ptr <-> input.list;
		};
		let i <-> size;
		delete size;
		${:loop;
			let v1 <-> enum();
			let j <-> enum();
			%j = 0;
			let loopEntry_next;
			jump -> loopEntry_next;//start j at 1
			${:loop;//checks a[j-1],a[j]
				let v2 <-> enum();
				ld %v2 %ptr %j;
				{:checkAndSwap;
					r0 = %v2 - %v1;//sorts from low -> high
					jump -> checkAndSwap..return if <= 0;
					st %v1 %ptr %j;//[j+1] = v1
					%j -= 1;
					st %v2 %ptr %j;//[j] = v2
					%j += 1;
					//%v1 ^= %v2;//v1^v2,v2
					//%v2 ^= %v1;//v1^v2,v1
					//%v1 ^= %v2;//v2,v1
				};
				def loopEntry_next;
				ld %v1 %ptr %j;//update v1
				%j += 1;
				r0 = %i - %j;//j - (size - i)
				jump -> loop if > 0;
			};
			%i -= 1;
			jump -> loop if > 0;
		};
	};
	jump -> %ret;
};
let array;{:inputParsing;
	let data1 = #(){
		3   4
		4   3
		2   5
		1   3
		3   9
		3   3
	}[0][0];
	let data1.parseData(data){
		#return = data..iterate((v){@(v..asNumber)});
	};
	let data2 = {import "day1 input.txt" as text};
	let data2.parseData:>(string){//:int[]
		:data;
		let i = 0;
		let numberString;
		repeat (i<string..length && string..length): #{
			defer: #i+=1;
			#((string[i] == " ") || (string[i] == +"\n"))
				&&{
					repeat !!numberString..length
						#data::{@(¬(""...numberString)¬..asNumber)};
					#numberString = {};
				}
				||{
					#numberString::{@(+string[i])};
				}
			;
		};
	}();
	let data = data1.parseData(data1);
	#array<=>data;
	#array{
		let length = array..@..length;
		let data{
			def length;
			def array;
		};
	};
};
let main(){
	let enum = Enum();
	let stackPtr = enum();
	let tempArray = {repeat 2 ${repeat(array..@..length/2) 0}};//note: 0 -> 0x1E == null value
	let arrayLength <-> enum();//UNUSED
	let tempArrayLength <-> enum();//UNUSED
	//TODO allow for array slices, and arrays with unknown size
	#var()<:{def tempArray;ram=>dynamic.stack}<:dynamic.stack;
	print("input:");
	printArray.short(enum,array);
	print.inline("\n");
	{:sortArrays;
		let enum = Enum(enum);
		let i <-> enum();
		let copyToTempArray(i,array,tempArray){
			:loop;
			let enum = Enum(enum);
			let temp <-> enum();
			let j <-> enum();
			ld %temp %i array;
			%j = %i >> 1;
			st %temp %j tempArray;
			%i += 2;
			r0 = %i - array..@..length;
			jump -> loop if < 0;
		};
		tempArray..iterate((v,j){
			%i = 0;
			repeat(j == 1) %i += 1;
			copyToTempArray(i,array,tempArray[j]);
			setU32_const(bubbleSort.input[0],tempArray[j],tempArray[j]..@..length);
			printArray.short(enum,tempArray[j]);
			print.inline("\n");
			$call(bubbleSort);
			print("->");
			printArray.short(enum,tempArray[j]);
			print.inline("\n");
		};
	};
	let sum <-> enum();
	{:sumArrays;
		let enum = Enum(enum);
		let i <-> enum();
		%i = tempArray.(0)..@..length;
		%i -= 1;
		%sum = 0;
		${:loop;
			let a <-> enum();
			let b <-> enum();
			ld %a %i tempArray.(0);
			ld %b %i tempArray.(1);
			let difference <-> b;
			%difference = %a - %b;//
			{:abs;
				jump -> abs..return if >= 0;
				%difference ^= 0xffff;
				%difference += 1;//2's complement
			};//assert: %difference >= 0
			%sum += %difference;
			%i -= 1;
			jump -> loop if >= 0;
		};
	};
	print("Answer1: ");
	print.u16.call_safe(sum);
	print.inline("\n");
	let ans1 = sum;
	delete sum;
	let ans2 <-> enum();
	let sum = ans2;
	for.repeat(enum,tempArray[0]..@..length)<:(i,enum){
		let v1 <-> enum();
		ld %v1 %i tempArray.(0);
		for.repeat(enum,tempArray[0]..@..length)<:(j,enum){
			let v2 <-> enum();
			ld %v2 %j tempArray.(1);
			r0 = %v1 - %v2;
			jump -> return..return if != 0;
			exh %v1 %v1;
			exh %v2 %v2;
			r0 = %v1 - %v2;
			exh %v1 %v1 !flags;
			jump -> return..return if != 0;
			%sum += %v1;
		};
	};
	print("Answer2: ");
	print.u16.call_safe(sum);
	print.inline("\n");
	hlt;
};
main();
{
	def static.data;
	def static.stack;
	def array.data;
	def bubbleSort;
	def print.u16;
	def print.u4;
	def dynamic.stack;
	def dynamic.heap;
};